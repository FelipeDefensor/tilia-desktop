<?xml version="1.0" encoding="UTF-8"?>
<!-- A six-measure, two-voice phrase in C major built from three schemata,
     one stage per half note, so the schema annotations are right by
     construction:
       mm. 1-2  Romanesca (stepwise)  upper 1 5 1 1   bass 1 7 6 3
       mm. 3-4  Prinner               upper 6 5 4 3   bass 4 3 2 1
       mm. 5-6  Do-Re-Mi              upper 1 2 3     bass 1 7 1 -->
